  object IBUpdateSQL1: TIBUpdateSQL
    RefreshSQL.Strings = (
      'Select A.COUNTRY, A.CURRENCY From COUNTRY A'
      'Where A.COUNTRY = :COUNTRY'
    )
    ModifySQL.Strings = (
      'Update CUSTOMER A Set '
      '  A.CUST_NO = :CUST_NO,'
      '  A.CUSTOMER = :CUSTOMER,'
      '  A.CONTACT_FIRST = :CONTACT_FIRST,'
      '  A.CONTACT_LAST = :CONTACT_LAST,'
      '  A.PHONE_NO = :PHONE_NO,'
      '  A.ADDRESS_LINE1 = :ADDRESS_LINE1,'
      '  A.ADDRESS_LINE2 = :ADDRESS_LINE2,'
      '  A.CITY = :CITY,'
      '  A.STATE_PROVINCE = :STATE_PROVINCE,'
      '  A.COUNTRY = :COUNTRY,'
      '  A.POSTAL_CODE = :POSTAL_CODE,'
      '  A.ON_HOLD = :ON_HOLD'
      'Where A.CUST_NO = :OLD_CUST_NO'
    )
    InsertSQL.Strings = (
      'Insert Into CUSTOMER(CUST_NO, CUSTOMER, CONTACT_FIRST, CONTACT_LAST, PHONE_NO, ADDRESS_LINE1, ADDRESS_LINE2, CITY, STATE_PROVINCE, COUNTRY, POSTAL_CODE, ON_HOLD)'
      'Values(:CUST_NO, :CUSTOMER, :CONTACT_FIRST, :CONTACT_LAST, :PHONE_NO, :ADDRESS_LINE1, :ADDRESS_LINE2, :CITY, :STATE_PROVINCE, :COUNTRY, :POSTAL_CODE, :ON_HOLD)'
    )
    DeleteSQL.Strings = (
      'Delete From CUSTOMER A'
      'Where A.CUST_NO = :CUST_NO'
    )
    left = 288
    top = 257
  end
